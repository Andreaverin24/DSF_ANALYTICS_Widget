    android:id="@+id/counter_flipper" android:layout_width="wrap_content" android:layout_height="32dp"
    android:autoStart="false" android:animateFirstView="true"
    android:inAnimation="@anim/counter_in_down" android:outAnimation="@anim/counter_out_down">
    <ImageView android:id="@+id/counter_before" style="@style/CounterGlyph" />
    <ImageView android:id="@+id/counter_after" style="@style/CounterGlyph" />
</ViewFlipper>
